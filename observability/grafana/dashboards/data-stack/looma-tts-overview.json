    {
      "id": 48,
      "type": "timeseries",
      "title": "Wait from Speak to first sound",
      "description": "p50 and p95 of the wait per time bucket. Empty stretches mean nobody pressed Speak, not that the wait was zero.",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "queryType": "lucene",
          "query": "name:\"tts.piper.first_audio\" AND resource.attributes.looma@device_name:/${device:regex}/ AND resource.attributes.looma@geo_city:/${city:regex}/ AND resource.attributes.looma@geo_country:/${country:regex}/ AND NOT status.code:2",
          "timeField": "startTime",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "durationInNanos",
              "settings": {
                "percents": [
                  "50",
                  "95"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "9",
              "type": "date_histogram",
              "field": "startTime",
              "settings": {
                "interval": "auto",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "luceneQueryType": "Metric",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/p50.*/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p50"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/p95.*/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 1,
      "title": "Overview · server-side TTS (Piper)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "TTS requests ($__range)",
      "description": "Total Piper synthesis calls completed in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traces_span_metrics_calls_total{service_name=\"looma-web\",span_name=\"tts.piper\", looma_device_name=~\"$device\", looma_geo_city=~\"$city\", looma_geo_country=~\"$country\"}[$__range])) or vector(0)",
          "legendFormat": "requests"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors ($__range)",
      "description": "Synthesis calls that ended with span status STATUS_CODE_ERROR  in the selected range.",
