# looma-ledstatus configuration
# Copy to ~/.config/looma-ledstatus/config.env and edit.
# Every value here is the built-in default; uncomment to override.

# ==========================================================================
# HTTP endpoint the ESP32 polls
# ==========================================================================
#LOOMA_LED_HTTP_HOST=0.0.0.0
#LOOMA_LED_HTTP_PORT=38070

# ==========================================================================
# O - Looma OpenSearch cluster health (green/yellow/red straight from the API)
# ==========================================================================
#LOOMA_LED_OS_URL=http://localhost:49200
#LOOMA_LED_OS_TIMEOUT=5

# ==========================================================================
# H - looma.website reachability (green = HTTP 200..UP_MAX, red = anything else)
# ==========================================================================
#LOOMA_LED_HEARTBEAT_URL=https://looma.website
#LOOMA_LED_HEARTBEAT_UP_MAX=399
#LOOMA_LED_HEARTBEAT_TIMEOUT=5

# ==========================================================================
# U - looma-vector container state (green = running, red = anything else)
# ==========================================================================
#LOOMA_LED_VECTOR_CONTAINER=looma-vector
#LOOMA_LED_DOCKER_TIMEOUT=5

# ==========================================================================
# d - Size of looma_* Docker volumes (measured every DISK_POLL_INTERVAL by
#     spinning a throwaway `busybox du` container — NOT on the fast poll loop)
# ==========================================================================
#LOOMA_LED_VOLUME_PREFIX=looma_
#LOOMA_LED_DISK_WARN_GB=5
#LOOMA_LED_DISK_CRIT_GB=10
#LOOMA_LED_DISK_MEASURE_TIMEOUT=60

# ==========================================================================
# P - looma-prometheus health (green = HTTP 200..399 on PROM_HEALTH_PATH,
#     red = anything else). Not published to the host, so this looks up the
#     container's own Docker-network IP via `docker inspect` on every poll.
# ==========================================================================
#LOOMA_LED_PROM_CONTAINER=looma-prometheus
#LOOMA_LED_PROM_PORT=9091
#LOOMA_LED_PROM_HEALTH_PATH=/-/healthy
#LOOMA_LED_PROM_TIMEOUT=5

# ==========================================================================
# TIMING
# ==========================================================================
#LOOMA_LED_POLL_INTERVAL=10
#LOOMA_LED_DISK_POLL_INTERVAL=300
