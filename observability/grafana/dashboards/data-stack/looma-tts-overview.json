        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traces_span_metrics_calls_total{service_name=\"looma-web\",span_name=\"tts.piper\", looma_device_name=~\"$device\", looma_geo_city=~\"$city\", looma_geo_country=~\"$country\",status_code=\"STATUS_CODE_ERROR\"}[$__range])) or vector(0)",
          "legendFormat": "errors"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
