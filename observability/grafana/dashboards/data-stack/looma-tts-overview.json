{
  "annotations": {
    "list": []
  },
  "description": "RED metrics — requests, errors, latency — for the server-side TTS engines (Piper), derived from OpenTelemetry span metrics. Browser Speech runs on the student device and has its own dashboard.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "title": "Looma — TTS",
  "uid": "looma-tts",
  "tags": [
    "looma",
    "tts",
    "overview"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "TTS dashboards",
      "tags": [
        "tts"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(traces_span_metrics_calls_total, looma_device_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "city",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(traces_span_metrics_calls_total, looma_geo_city)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "country",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(traces_span_metrics_calls_total, looma_geo_country)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "rate",
        "label": "Rate window",
        "type": "interval",
        "query": "1m,5m,10m,30m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "10m",
            "value": "10m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ],
        "auto": false
      }
    ]
  },
  "panels": [
    {
      "id": 40,
      "type": "row",
      "title": "Piper · wait from pressing Speak to the first sound",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Presses",
      "description": "Speak presses that started a new Piper reading and reached the first sound. Pausing and resuming a reading is not a new press.",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-traces"
          },
          "queryType": "lucene",
          "query": "name:\"tts.piper.first_audio\" AND resource.attributes.looma@device_name:/${device:regex}/ AND resource.attributes.looma@geo_city:/${city:regex}/ AND resource.attributes.looma@geo_country:/${country:regex}/ AND NOT status.code:2",
          "timeField": "startTime",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "9",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            }
          ],
          "luceneQueryType": "Metric",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(?!Name$|name$).*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "no presses",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
