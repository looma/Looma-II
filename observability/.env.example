# Copy to .env and adjust. Only read by docker-compose.data-server.yml — the
# canonical docker-compose.yml (odroid on-box "full" profile, dev machine)
# never looks at this file and does not need it.
#
#   cp .env.example .env
#   docker network create loomanet   # only if it doesn't exist yet
#   docker compose -f docker-compose.yml -f docker-compose.data-server.yml up -d --build
#
# See DATA-SERVER.md.

# Where this stack's OpenSearch/Prometheus/Grafana/OTel/Vector data and
# OpenSearch snapshots live on disk. Must be a real mounted disk (the
# migrate-volumes-to-disk.sh script refuses to run otherwise) — this stack
# accumulates telemetry from every Looma box in the field indefinitely.
LOOMA_DATA_ROOT=/mnt/looma

# LAN-only exposure of the data stack (Grafana, Dashboards, OTLP, Vector, Data Prepper).
# Set to this host's private LAN IP (reserve it in the router DHCP) — never 0.0.0.0.
# Unset = loopback only.
#LOOMA_LAN_BIND_ADDR=192.168.1.115
