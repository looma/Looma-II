# looma-ledstatus configuration
# Copy to ~/.config/looma-ledstatus/config.env and edit.
# Every value here is the built-in default; uncomment to override.

# ==========================================================================
# HTTP endpoint the ESP8266 polls
# ==========================================================================
#LOOMA_LED_HTTP_HOST=0.0.0.0
#LOOMA_LED_HTTP_PORT=38070

# ==========================================================================
# App — one code per technology (display-cycle order: H d t S A O U P)
# ==========================================================================
# H - web: Apache + PHP (looma-web). green = HTTP 200..UP_MAX
#LOOMA_LED_WEB_URL=http://localhost:48080/
# d - MongoDB (looma-db): TCP connect to the published port
#LOOMA_LED_MONGO_HOST=localhost
#LOOMA_LED_MONGO_PORT=47017
# t - Piper TTS (looma-piper): /health on the container's Docker-network IP
#     (not published to the host); yellow = up but a voice file is missing
#LOOMA_LED_PIPER_CONTAINER=looma-piper
#LOOMA_LED_PIPER_PORT=5002
# S - semantic search (looma-search)
#LOOMA_LED_SEARCH_URL=http://localhost:46333/health
# A - AI assistant (looma-ai). Optional: a missing container is yellow,
#     an exited one red.
#LOOMA_LED_AI_CONTAINER=looma-ai
#LOOMA_LED_AI_URL=http://localhost:8089/health

# ==========================================================================
# Observability
# ==========================================================================
# O - OpenSearch cluster health (a 1-node cluster whose only unassigned
#     shards are replicas counts as green)
#LOOMA_LED_OS_URL=http://localhost:49200
# U - looma-vector container state
#LOOMA_LED_VECTOR_CONTAINER=looma-vector
# P - looma-prometheus health (container IP; it listens on 9091, not 9090)
#LOOMA_LED_PROM_CONTAINER=looma-prometheus
#LOOMA_LED_PROM_PORT=9091
#LOOMA_LED_PROM_HEALTH_PATH=/-/healthy

# ==========================================================================
# TIMING / thresholds
# ==========================================================================
#LOOMA_LED_UP_MAX=399            # highest HTTP status that still counts as up
#LOOMA_LED_TIMEOUT=5
#LOOMA_LED_DOCKER_TIMEOUT=5
#LOOMA_LED_POLL_INTERVAL=10
