// Copy this file to secrets.h (same folder) and fill in your real values.
// secrets.h is gitignored — never commit real WiFi credentials.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// LAN IP (or hostname) of the machine running status_server.py — the
// data-server host, on the same network as this ESP8266.
#define STATUS_HOST "192.168.1.100"
#define STATUS_PORT 38070
#define STATUS_PATH "/status"
